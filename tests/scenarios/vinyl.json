  {"action":"assert","name":"bubble-box-holds-text","js":"(function(){ const box = document.querySelector('#bubble .box'); const b = box.getBoundingClientRect(); const target = parseFloat(box.style.height) || b.height; const i = document.querySelector('#bubble .inner').getBoundingClientRect(); return b.width >= 380 && target >= i.height - 2 && target < i.height + 40; })()"},
  {"action":"shot","name":"austen-typing"},
  {"action":"wait","ms":1500},
  {"action":"assert","name":"bubble-grew-with-text","js":"(function(){ const box = document.querySelector('#bubble .box'); const target = parseFloat(box.style.height) || box.getBoundingClientRect().height; const i = document.querySelector('#bubble .inner').getBoundingClientRect(); const n = document.querySelector('#bubble .text').textContent.length; return n > 60 && target >= i.height - 2; })()"},

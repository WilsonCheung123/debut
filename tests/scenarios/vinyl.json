  {"action":"wait","ms":900},
  {"action":"assert","name":"record-click-pauses","js":"window.__table.state.music.isPlaying === false && window.__table.music.playerState() === 2"},
  {"action":"click-object","id":"vinyl"},
  {"action":"wait","ms":2600},
  {"action":"assert","name":"record-click-plays","js":"window.__table.state.music.isPlaying === true && window.__table.music.playerState() === 1"},
  {"action":"exit"},
  {"action":"wait","ms":800},
  {"action":"assert","name":"tile-docked-in-corner-while-playing","js":"(function(){ const d = document.getElementById('music-dock'); const r = d.getBoundingClientRect(); const cs = getComputedStyle(d); return cs.visibility === 'visible' && r.width >= 200 && r.height >= 200 && r.left >= 0 && r.bottom <= innerHeight && r.right < innerWidth / 2; })()"},
  {"action":"shot","name":"rest-playing"},
  {"action":"assert","name":"still-playing-at-rest","js":"window.__table.state.music.isPlaying === true"},


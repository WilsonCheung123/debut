  {"action":"assert","name":"first-track-shown","js":"window.__table.music.track().index === 0 && window.__table.music.track().count === 15 && document.querySelector('.vinyl-panel .vinyl-title').textContent === 'Time' && document.querySelector('.vinyl-panel .vinyl-count').textContent === '1 / 15'"},
  {"action":"assert","name":"player-tile-visible-200","js":"(function(){ const d = document.getElementById('music-dock'); const r = d.getBoundingClientRect(); const cs = getComputedStyle(d); return r.width >= 200 && r.height >= 200 && cs.visibility === 'visible' && +cs.opacity > 0.9 && r.right <= innerWidth && r.bottom <= innerHeight; })()"},

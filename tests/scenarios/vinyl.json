[
  {"action":"wait","ready":true},
  {"action":"assert","name":"music-hook","js":"typeof window.__table.music.setPlaying === 'function' && window.__table.music.status() === 'idle'"},
  {"action":"assert","name":"no-spotify-at-load","js":"!document.querySelector('script[src*=\"open.spotify.com\"]') && !document.getElementById('spotify-dock')"},
  {"action":"hover","id":"vinyl"},
  {"action":"shot","name":"hover"},
  {"action":"eval","js":"window.__table.hover(null)"},
  {"action":"focus","id":"vinyl"},
  {"action":"assert","name":"embed-lazy-loaded-on-focus","js":"!!document.querySelector('script[src*=\"open.spotify.com/embed/iframe-api\"]')"},
  {"action":"log","name":"music-status","js":"window.__table.music.status()"},
  {"action":"shot","name":"focus-loading"},
  {"action":"wait","selector":"#spotify-dock iframe, .vinyl-panel .vinyl-off","timeout":15000},
  {"action":"wait","ms":1500},
  {"action":"log","name":"music-status","js":"({status: window.__table.music.status(), controller: window.__table.music.hasController(), reports: window.__table.music.reportsState()})"},
  {"action":"assert","name":"embed-or-fallback","js":"(function(){ const s = window.__table.music.status(); return s === 'ready' || s === 'fallback'; })()"},
  {"action":"shot","name":"focus"},
  {"action":"click","selector":".vinyl-panel .vinyl-toggle"},
  {"action":"wait","ms":2600},
  {"action":"assert","name":"toggle-sets-playing","js":"window.__table.state.music.isPlaying === true && document.querySelector('.vinyl-panel .vinyl-toggle').getAttribute('aria-pressed') === 'true'"},
  {"action":"shot","name":"focus-playing"},
  {"action":"exit"},
  {"action":"assert","name":"dock-parked-still-alive","js":"(function(){ const d = document.getElementById('spotify-dock'); return !d || (getComputedStyle(d).visibility === 'hidden' && getComputedStyle(d).display !== 'none'); })()"},
  {"action":"wait","ms":800},
  {"action":"shot","name":"rest-playing"},
  {"action":"assert","name":"still-playing-at-rest","js":"window.__table.state.music.isPlaying === true"},

  {"action":"focus","id":"book.pride-and-prejudice"},
  {"action":"wait","ms":900},
  {"action":"assert","name":"austen-paused","js":"window.__table.state.music.isPlaying === false"},
  {"action":"assert","name":"austen-bubble","js":"!document.getElementById('bubble').hidden && document.querySelector('#bubble .ask-btn') !== null"},
  {"action":"shot","name":"austen-ask"},
  {"action":"tap","selector":"#bubble .ask-btn"},
  {"action":"wait","ms":1500},
  {"action":"assert","name":"austen-typing","js":"(function(){ const n = document.querySelector('#bubble .text').textContent.length; return n > 10 && n < 500; })()"},
  {"action":"assert","name":"bubble-size-stable","js":"(function(){ const b = document.querySelector('#bubble .box').getBoundingClientRect(); const g = document.querySelector('#bubble .ghost').getBoundingClientRect(); return b.width >= 380 && b.height > g.height; })()"},
  {"action":"shot","name":"austen-typing"},
  {"action":"click","selector":"#bubble .box"},
  {"action":"wait","ms":900},
  {"action":"assert","name":"austen-complete-on-click","js":"document.querySelector('#bubble .text').textContent.length > 500 && +getComputedStyle(document.querySelector('#bubble .after')).opacity > 0.9 && document.querySelector('#bubble .after a').getAttribute('href').length > 10"},
  {"action":"shot","name":"austen-answer"},
  {"action":"click","selector":"#panel .body"},
  {"action":"wait","ms":500},
  {"action":"assert","name":"bubble-dismissed-on-click-outside","js":"document.getElementById('bubble').hidden && !document.querySelector('.austen-again').hidden"},
  {"action":"click","selector":".austen-again button"},
  {"action":"wait","ms":600},
  {"action":"assert","name":"bubble-back-from-panel","js":"!document.getElementById('bubble').hidden && document.querySelector('#bubble .ask-btn') !== null"},
  {"action":"exit"},
  {"action":"assert","name":"bubble-gone-on-exit","js":"document.getElementById('bubble').hidden"},
  {"action":"assert","name":"music-stays-paused","js":"window.__table.state.music.isPlaying === false"},
  {"action":"wait","ms":2500},
  {"action":"shot","name":"rest-after"}

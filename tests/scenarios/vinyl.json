  {"action":"click","selector":".vinyl-panel .vinyl-prev"},
  {"action":"wait","ms":900},
  {"action":"assert","name":"prev-returns","js":"window.__table.music.track().index === 0 && window.__table.state.music.isPlaying === true"},

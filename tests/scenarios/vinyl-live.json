[
  {
    "action": "wait",
    "ready": true
  },
  {
    "action": "focus",
    "id": "vinyl"
  },
  {
    "action": "wait",
    "selector": "#music-dock iframe",
    "timeout": 20000
  },
  {
    "action": "wait",
    "ms": 2500
  },
  {
    "action": "assert",
    "name": "player-ready-and-cued",
    "js": "window.__table.music.status() === 'ready' && window.__table.music.hasController() && window.__table.state.music.isPlaying === false"
  },
  {
    "action": "log",
    "name": "cued-track",
    "js": "window.__table.music.track()"
  },
  {
    "action": "assert",
    "name": "first-track-title-shown",
    "js": "document.querySelector('.vinyl-panel .vinyl-title').textContent.length > 0"
  },
  {
    "action": "shot",
    "name": "live-cued"
  },
  {
    "action": "click",
    "selector": ".vinyl-panel .vinyl-toggle"
  },
  {
    "action": "wait",
    "ms": 4000
  },
  {
    "action": "log",
    "name": "after-play",
    "js": "({playing: window.__table.music.playing, reports: window.__table.music.reportsState(), playerState: window.__table.music.playerState(), error: window.__table.music.lastError()})"
  },
  {
    "action": "assert",
    "name": "player-reports-playing",
    "js": "window.__table.music.reportsState() === true && window.__table.music.playerState() === 1 && window.__table.music.playing === true"
  },
  {
    "action": "shot",
    "name": "live-playing"
  },
  {
    "action": "click",
    "selector": ".vinyl-panel .vinyl-next"
  },
  {
    "action": "wait",
    "ms": 3500
  },
  {
    "action": "log",
    "name": "after-next",
    "js": "({track: window.__table.music.track(), playerState: window.__table.music.playerState(), playing: window.__table.music.playing})"
  },
  {
    "action": "assert",
    "name": "next-advances-and-keeps-playing",
    "js": "window.__table.music.track().index === 1 && window.__table.music.playing === true && window.__table.music.playerState() === 1"
  },
  {
    "action": "click",
    "selector": ".vinyl-panel .vinyl-toggle"
  },
  {
    "action": "wait",
    "ms": 2500
  },
  {
    "action": "assert",
    "name": "toggle-pauses-player",
    "js": "window.__table.music.playerState() === 2 && window.__table.music.playing === false"
  },
  {
    "action": "click",
    "selector": ".vinyl-panel .vinyl-toggle"
  },
  {
    "action": "wait",
    "ms": 4000
  },
  {
    "action": "assert",
    "name": "toggle-resumes-player",
    "js": "window.__table.music.playerState() === 1 && window.__table.music.playing === true"
  },
  {
    "action": "exit"
  },
  {
    "action": "wait",
    "ms": 4000
  },
  {
    "action": "log",
    "name": "after-exit",
    "js": "({playing: window.__table.music.playing, playerState: window.__table.music.playerState()})"
  },
  {
    "action": "assert",
    "name": "keeps-playing-when-panel-closed",
    "js": "window.__table.music.playing === true && window.__table.music.playerState() === 1"
  },
  {
    "action": "shot",
    "name": "live-rest"
  },
  {
    "action": "focus",
    "id": "book.pride-and-prejudice"
  },
  {
    "action": "wait",
    "ms": 2500
  },
  {
    "action": "log",
    "name": "after-austen",
    "js": "({playing: window.__table.music.playing, playerState: window.__table.music.playerState(), bubble: !document.getElementById('bubble').hidden})"
  },
  {
    "action": "assert",
    "name": "austen-really-pauses-player",
    "js": "window.__table.music.playing === false && window.__table.music.playerState() === 2 && !document.getElementById('bubble').hidden"
  },
  {
    "action": "shot",
    "name": "live-austen"
  },
  {
    "action": "exit"
  },
  {
    "action": "wait",
    "ms": 2000
  },
  {
    "action": "assert",
    "name": "no-auto-resume",
    "js": "window.__table.music.playing === false && window.__table.music.playerState() === 2"
  }
]
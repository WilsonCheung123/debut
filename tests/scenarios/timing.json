[
  {
    "action": "wait",
    "ready": true
  },
  {
    "action": "clock",
    "pause": true
  },
  {
    "action": "click-object",
    "id": "fpga"
  },
  {
    "action": "clock",
    "runFor": 100
  },
  {
    "action": "assert",
    "name": "focus-started",
    "js": "window.__table.state.focused === 'fpga' && window.__table.info().mode === 'moving'"
  },
  {
    "action": "clock",
    "runFor": 330
  },
  {
    "action": "assert",
    "name": "panel-not-before-450",
    "js": "document.getElementById('panel').hidden === true"
  },
  {
    "action": "clock",
    "runFor": 40
  },
  {
    "action": "assert",
    "name": "panel-open-at-450",
    "js": "document.getElementById('panel').hidden === false && window.__table.info().mode === 'moving'"
  },
  {
    "action": "shot",
    "name": "t470-panel-entering"
  },
  {
    "action": "clock",
    "runFor": 150
  },
  {
    "action": "shot",
    "name": "t650-mid-move"
  },
  {
    "action": "clock",
    "runFor": 300
  },
  {
    "action": "assert",
    "name": "camera-settled-after-900",
    "js": "window.__table.info().mode === 'focus'"
  },
  {
    "action": "timing",
    "name": "fpga"
  },
  {
    "action": "shot",
    "name": "t-focused"
  },
  {
    "action": "press",
    "key": "Escape"
  },
  {
    "action": "clock",
    "runFor": 200
  },
  {
    "action": "assert",
    "name": "panel-leaving-at-200",
    "js": "document.getElementById('panel').hidden === false && window.__table.state.focused === null && window.__table.info().mode === 'moving'"
  },
  {
    "action": "clock",
    "runFor": 100
  },
  {
    "action": "assert",
    "name": "panel-gone-by-300",
    "js": "document.getElementById('panel').hidden === true"
  },
  {
    "action": "clock",
    "runFor": 450
  },
  {
    "action": "assert",
    "name": "camera-returning-at-750",
    "js": "window.__table.info().mode === 'moving'"
  },
  {
    "action": "clock",
    "runFor": 120
  },
  {
    "action": "assert",
    "name": "camera-rest-by-870",
    "js": "window.__table.info().mode === 'rest'"
  },
  {
    "action": "shot",
    "name": "t-rest-again"
  }
]
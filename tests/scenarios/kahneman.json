[
  {"action":"wait","ready":true},
  {"action":"eval","js":"localStorage.removeItem('kahneman.group'); localStorage.removeItem('kahneman.guess')"},
  {"action":"focus","id":"book.thinking-fast-slow","cluster":true},
  {"action":"assert","name":"kahneman-panel","js":"!!document.querySelector('#panel .kahneman') && document.getElementById('panel-title').textContent === 'Thinking, Fast and Slow'"},
  {"action":"assert","name":"group-assigned","js":"['A','B'].includes(localStorage.getItem('kahneman.group'))"},
  {"action":"assert","name":"q1-anchor-matches-group","js":"document.querySelector('#panel .kahneman .q').textContent.includes(localStorage.getItem('kahneman.group') === 'A' ? '114' : '35')"},
  {"action":"assert","name":"svg-loaded","js":"(function(){ const i = document.querySelector('#panel .kahneman .trick img'); return i.complete && i.naturalWidth > 0; })()"},
  {"action":"shot","name":"k1-rest"},

  {"action":"eval","js":"document.querySelector('#panel .kahneman .trick').dispatchEvent(new PointerEvent('pointerdown',{bubbles:true,cancelable:true,pointerId:7,button:0,pointerType:'mouse',isPrimary:true}))"},
  {"action":"wait","ms":900},
  {"action":"assert","name":"held-proof-visible","js":"document.querySelector('#panel .kahneman').dataset.held === '1' && +getComputedStyle(document.querySelector('#panel .kahneman .field')).opacity > 0.98"},
  {"action":"shot","name":"k2-hold"},
  {"action":"eval","js":"document.querySelector('#panel .kahneman .trick').dispatchEvent(new PointerEvent('pointerup',{bubbles:true,cancelable:true,pointerId:7,button:0,pointerType:'mouse',isPrimary:true}))"},
  {"action":"wait","ms":800},
  {"action":"assert","name":"released-illusion-back","js":"!document.querySelector('#panel .kahneman').dataset.held && +getComputedStyle(document.querySelector('#panel .kahneman .field')).opacity < 0.02"},

  {"action":"click","selector":"#panel .kahneman .choices button[data-choice=older]"},
  {"action":"wait","ms":700},
  {"action":"assert","name":"q2-shown-input-focused","js":"document.querySelector('#panel .kahneman').dataset.step === 'q2' && document.activeElement === document.querySelector('#panel .kahneman input')"},
  {"action":"shot","name":"k3-q2"},
  {"action":"fill","selector":"#panel .kahneman input","text":"200"},
  {"action":"press","key":"Enter"},
  {"action":"wait","ms":200},
  {"action":"assert","name":"invalid-guess-hint","js":"document.querySelector('#panel .kahneman .hint').textContent.length > 0 && document.querySelector('#panel .kahneman').dataset.step === 'q2'"},
  {"action":"fill","selector":"#panel .kahneman input","text":"60"},
  {"action":"press","key":"Enter"},
  {"action":"wait","selector":"#panel .kahneman .reveal"},
  {"action":"wait","ms":2200},
  {"action":"assert","name":"reveal-numbers-match-api","js":"fetch('/api/anchor/stats').then(r=>r.json()).then(s=>{ const f=v=>Number.isInteger(v)?String(v):v.toFixed(1); const t=[...document.querySelectorAll('#panel .kahneman .num')].map(e=>e.textContent); return t[0]===f(s.A.mean) && t[1]===f(s.B.mean) && t[2]==='78'; })"},
  {"action":"assert","name":"counts-shown","js":"fetch('/api/anchor/stats').then(r=>r.json()).then(s=>{ const t=[...document.querySelectorAll('#panel .kahneman .col .n')].map(e=>e.textContent); return t[0]===`from ${s.A.n} people` && t[1]===`from ${s.B.n} people` && t[2]==='1869 to 1948'; })"},
  {"action":"assert","name":"own-guess-highlighted","js":"(function(){ const g=localStorage.getItem('kahneman.group'); const cols=[...document.querySelectorAll('#panel .kahneman .col')]; const mine=cols[g==='A'?0:1]; return mine.classList.contains('mine') && mine.classList.contains('lit') && mine.querySelector('.you').textContent==='you said 60' && cols.filter(c=>c.classList.contains('mine')).length===1; })()"},
  {"action":"assert","name":"stored-guess","js":"localStorage.getItem('kahneman.guess')==='60'"},
  {"action":"assert","name":"explain-and-close-verbatim","js":"document.querySelector('#panel .kahneman .explain').textContent === \"The first number was random and obviously wrong. It still pulled your guess toward it. That's anchoring: the mind starts from whatever it was handed and doesn't adjust far enough.\" && document.querySelector('#panel .kahneman .closing').textContent === 'Like squares A and B: you can know the number is irrelevant and still be moved by it.'"},
  {"action":"shot","name":"k4-reveal"},
  {"action":"exit"},

  {"action":"focus","id":"book.thinking-fast-slow","cluster":true},
  {"action":"wait","selector":"#panel .kahneman .reveal"},
  {"action":"wait","ms":2000},
  {"action":"assert","name":"returning-visitor-sees-reveal","js":"document.querySelector('#panel .kahneman').dataset.step==='reveal' && !document.querySelector('#panel .kahneman .q1') && document.querySelector('#panel .kahneman .col.mine .you').textContent==='you said 60'"},
  {"action":"shot","name":"k5-return"},

  {"action":"eval","js":"document.querySelector('#panel .kahneman .trick').focus()"},
  {"action":"eval","js":"document.querySelector('#panel .kahneman .trick').dispatchEvent(new KeyboardEvent('keydown',{key:' ',bubbles:true,cancelable:true}))"},
  {"action":"wait","ms":800},
  {"action":"assert","name":"keyboard-hold","js":"document.querySelector('#panel .kahneman').dataset.held==='1'"},
  {"action":"eval","js":"document.querySelector('#panel .kahneman .trick').dispatchEvent(new KeyboardEvent('keyup',{key:' ',bubbles:true,cancelable:true}))"},
  {"action":"wait","ms":700},
  {"action":"assert","name":"keyboard-release","js":"!document.querySelector('#panel .kahneman').dataset.held"},
  {"action":"exit"},
  {"action":"assert","name":"back-at-rest","js":"window.__table.info().mode === 'rest' && location.hash === ''"}
]

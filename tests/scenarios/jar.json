[
  {"action":"wait","ready":true},
  {"action":"hover","id":"jar"},
  {"action":"shot","name":"hover"},
  {"action":"eval","js":"window.__table.hover(null)"},
  {"action":"eval","js":"window.__jarDrops = 0; addEventListener('jar:dropped', () => { window.__jarDrops++; })"},
  {"action":"focus","id":"jar"},
  {"action":"wait","ms":900},
  {"action":"assert","name":"slip-unfolded","js":"!!document.querySelector('#panel .jar-slip') && +getComputedStyle(document.querySelector('#panel .jar-body')).opacity === 1 && +getComputedStyle(document.querySelector('#panel .jar-crumple')).opacity === 0"},
  {"action":"shot","name":"focus"},

  {"action":"click","selector":"#panel .jar-slip button[type=submit]"},
  {"action":"wait","ms":250},
  {"action":"assert","name":"empty-fields-rejected","js":"document.querySelectorAll('#panel .jar-field.bad').length === 3 && document.activeElement === document.querySelector('#panel input[name=name]')"},
  {"action":"shot","name":"errors"},
  {"action":"fill","selector":"#panel input[name=name]","text":"A scripted visitor"},
  {"action":"fill","selector":"#panel input[name=email]","text":"not an address"},
  {"action":"fill","selector":"#panel textarea[name=note]","text":"Testing the slip: this line was typed by Playwright, and it should look handwritten."},
  {"action":"click","selector":"#panel .jar-slip button[type=submit]"},
  {"action":"wait","ms":250},
  {"action":"assert","name":"bad-email-rejected","js":"document.querySelectorAll('#panel .jar-field.bad').length === 1 && document.querySelector('#panel .jar-field[data-field=email]').classList.contains('bad') && document.activeElement === document.querySelector('#panel input[name=email]')"},
  {"action":"fill","selector":"#panel input[name=email]","text":"visitor@example.com"},
  {"action":"wait","ms":150},
  {"action":"assert","name":"email-error-clears-on-input","js":"document.querySelectorAll('#panel .jar-field.bad').length === 0"},
  {"action":"shot","name":"filled"},

  {"action":"click","selector":"#panel .jar-slip button[type=submit]"},
  {"action":"wait","selector":"#panel .jar-done.show","timeout":20000},
  {"action":"wait","ms":2200},
  {"action":"assert","name":"done-line","js":"document.querySelector('#panel .jar-done').textContent.startsWith('In the jar.') && getComputedStyle(document.querySelector('#panel .jar-wrap')).display === 'none'"},
  {"action":"assert","name":"slip-landed-in-3d-jar","js":"window.__jarDrops === 1"},
  {"action":"shot","name":"done"},

  {"action":"click","selector":"#panel .jar-link"},
  {"action":"wait","ms":800},
  {"action":"assert","name":"principles-open","js":"document.querySelector('#panel .jar-principles').classList.contains('open') && document.querySelectorAll('#panel .jar-principles p').length >= 8 && document.querySelector('#panel .jar-link').getAttribute('aria-expanded') === 'true'"},
  {"action":"shot","name":"principles"},
  {"action":"click","selector":"#panel .jar-link"},
  {"action":"wait","ms":600},
  {"action":"assert","name":"principles-close","js":"!document.querySelector('#panel .jar-principles').classList.contains('open')"},
  {"action":"exit"},
  {"action":"assert","name":"back-at-rest","js":"window.__table.info().mode === 'rest' && location.hash === ''"}
]
